rule slang
    command = slangc $in -target spirv -fvk-use-scalar-layout -matrix-layout-column-major -fvk-use-entrypoint-name -Wno-39001 -I "shaders/compiled/" -I "shaders/modules/" -depfile ${out}.d -o $out
    depfile = ${out}.d
    deps = gcc

build shaders/compiled/copy_swapchain.spv: slang shaders/copy_swapchain.slang
build shaders/compiled/mesh.spv: slang shaders/mesh.slang
build shaders/compiled/culling.spv: slang shaders/culling.slang
build shaders/compiled/hiz_spd.spv: slang shaders/hiz_spd.slang

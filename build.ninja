rule slang
    command = slangc $in -target spirv -matrix-layout-column-major -fvk-use-entrypoint-name -fvk-use-scalar-layout -Wno-39001 -I "shaders/compiled/" -I "shaders/modules/" -o $out

build shaders/compiled/copy_swapchain.spv: slang shaders/copy_swapchain.slang
build shaders/compiled/mesh.spv: slang shaders/mesh.slang
build shaders/compiled/culling.spv: slang shaders/culling.slang
